  "setupInfo": { 
    // SCP:SL 启动命令（必须进入 serverfiles 目录执行）
    // SCP:SL 服务器是基于 .NET Core 的，需要在 Linux 上直接运行
    "startCommand": "cd serverfiles && ./LocalAdmin", 
    "stopCommand": "stop", // 通常退出控制台即可停止进程
    "ie": "utf8", 
    "oe": "utf8", 
    "type": "steam/universal", 
    "tag": ["scpsl"], 
    "fileCode": "utf8",
    "processType": "general", // 使用 general 进程类型，因为是原生执行文件
    
    // **重点：安装和更新命令 (SteamCMD 逻辑)**
    // 这个命令会在你第一次安装或点击“更新”时执行
    "updateCommand": [
      // 1. 检查并创建 steamcmd 目录
      "mkdir -p ./steamcmd && cd ./steamcmd",
      // 2. 下载 SteamCMD（-nc 表示不重复下载已存在的文件）
      "wget -nc https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz -O steamcmd_linux.tar.gz",
      // 3. 解压 SteamCMD
      "tar -zxvf steamcmd_linux.tar.gz",
      // 4. 返回根目录并创建服务器文件存放目录
      "cd .. && mkdir -p ./serverfiles",
      // 5. 运行 SteamCMD：登录匿名账号，设置安装目录，更新 AppID 991190 (SCP:SL Dedicated Server)
      "./steamcmd/steamcmd.sh +force_install_dir ./serverfiles +login anonymous +app_update 991190 validate +quit",
      // 6. 授予 SCP-SL 服务器执行权限
      "chmod +x ./serverfiles/LocalAdmin"
    ],
    
    // SCP:SL 服务器不需要 Docker 配置，因此以下字段留空或删除
    "docker": null
  }
}
